# Copy to .env before running: cp .env.example .env
# Values here are safe defaults for local dev — change anything marked CHANGE THIS.

# ── Database ──────────────────────────────────────────────────────────────────
# Used by docker-compose to set the Postgres superuser password and to
# construct DATABASE_URL for each service.
POSTGRES_PASSWORD=devpassword

# ── Auth ──────────────────────────────────────────────────────────────────────
# CHANGE THIS — must be a stable random string (32+ chars) in production.
# Tokens are invalidated if this changes, so pick one and keep it.
PLATFORM_SIGNING_KEY=dev-only-change-me-use-openssl-rand-hex-32

# Required to call POST /admin/tenants (tenant bootstrap).
# Set to a strong random secret; leave blank to disable the endpoint entirely.
# Generate: openssl rand -hex 32
ADMIN_BOOTSTRAP_TOKEN=

# ── Redis ──────────────────────────────────────────────────────────────────────
# Optional password — leave blank for dev, set in production.
# When set, Redis starts with --requirepass and REDIS_URL includes the password.
# Generate: openssl rand -hex 24
REDIS_PASSWORD=
# Full Redis URL (overrides the redis://redis:6379 default in docker-compose).
# With password: redis://:your-password@redis:6379
REDIS_URL=redis://redis:6379

# ── CORS ──────────────────────────────────────────────────────────────────────
# Comma-separated list of allowed frontend origins.
# Change to your production domain in production.
CORS_ORIGINS=http://localhost:3000,http://localhost:5173,http://localhost:5174

# ── Model backends (all optional — leave blank to use offline mocks) ──────────
#
# Ollama (local LLM — free, self-hosted)
#   1. Install Ollama: https://ollama.com
#   2. Pull a model: ollama pull qwen2.5:32b
#   3. Set OLLAMA_HOST to reach Ollama from inside Docker:
#      • Mac / Windows:  OLLAMA_HOST=http://host.docker.internal:11434
#      • Linux:          OLLAMA_HOST=http://172.17.0.1:11434
#        (or run: ip route | awk '/default/ {print $3}' to find the gateway IP)
OLLAMA_HOST=

# OpenRouter (hosted LLMs — free tier available, no GPU needed)
#   1. Sign up at https://openrouter.ai and copy your API key.
#   2. Paste it here. Free models (marked :free) have no cost.
OPENROUTER_API_KEY=

# ComfyUI (local image / video / TTS / music — free, self-hosted)
#   1. Install ComfyUI: https://github.com/comfyanonymous/ComfyUI
#   2. Set COMFYUI_URL to reach it from inside Docker:
#      • Mac / Windows:  COMFYUI_URL=http://host.docker.internal:8188
#      • Linux:          COMFYUI_URL=http://172.17.0.1:8188
COMFYUI_URL=

# Replicate (hosted GPU inference — image, video, TTS, music)
#   Sign up at https://replicate.com, copy your token from account settings.
#   Accept model terms on Replicate before the first API call:
#     https://replicate.com/black-forest-labs/flux-schnell  (image)
#     https://replicate.com/lightricks/ltx-video            (video)
#     https://replicate.com/jaaari/kokoro-82m               (TTS)
#     https://replicate.com/meta/musicgen                   (music)
REPLICATE_API_TOKEN=

# Hugging Face Inference API (free tier — image, TTS, music)
#   Sign up at https://huggingface.co, then get a token at:
#   https://huggingface.co/settings/tokens (read access is enough)
#   Accept model terms for FLUX.1-schnell: https://huggingface.co/black-forest-labs/FLUX.1-schnell
HF_API_TOKEN=

# Deepgram (TTS — $200 free credit on signup, no expiry)
#   Sign up at https://console.deepgram.com and copy your API key.
#   Used for generate_dialogue stage (replaces Replicate Kokoro).
DEEPGRAM_API_KEY=

# ── AWS Bedrock ────────────────────────────────────────────────────────────────
# Set AWS_BEDROCK_REGION to enable Claude on Bedrock (prod/staging).
# Also raise max_cost_per_job_usd in routing.yaml and uncomment Bedrock models.
#
# Option A — explicit credentials (dev/CI):
AWS_BEDROCK_REGION=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_SESSION_TOKEN=
#
# Option B — IAM role (ECS / EC2 in prod): set only AWS_BEDROCK_REGION.
# The credential chain picks up the task/instance role automatically.
# AWS_BEDROCK_REGION=us-east-1

# ── Logging ───────────────────────────────────────────────────────────────────
LOG_LEVEL=INFO
# json (machine-readable) | pretty (human-readable for local dev)
LOG_FORMAT=json
